{
  "name": "tau",
  "version": "1.0.0",
  "private": true,
  "description": "Opinionated workflow governor for pi.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main",
    "changeset:version": "changeset version && vp fmt",
    "check": "pnpm pi-version:check && pnpm run \"/^check:static:/\" && pnpm test",
    "check:static:format": "pnpm format:check",
    "check:static:knip": "pnpm knip",
    "check:static:style": "pnpm style:check",
    "check:static:typecheck": "pnpm typecheck",
    "fix": "vp lint --fix && vp fmt",
    "knip": "knip",
    "pi-version:check": "node scripts/checkPiVersion.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "style:check": "seam",
    "style:fix": "seam --fix",
    "prepare": "node scripts/prepare.ts",
    "test": "vp test",
    "test:changed": "vp test --changed",
    "test:coverage": "vp test --coverage",
    "test:unit": "vp test --exclude '**/*.integration.test.ts'",
    "token-usage": "node scripts/tokenUsage.ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "release:github": "pnpm changeset git-tag"
  },
  "dependencies": {
    "cc-safety-net": "2.4.1",
    "nanoid": "3.3.18",
    "pi-web-access": "0.33.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@oxlint/plugins": "1.79.0",
    "@sqve/seam": "0.1.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "jiti": "2.7.0",
    "knip": "6.37.0",
    "oxc-parser": "0.150.0",
    "oxlint": "1.79.0",
    "typebox": "1.3.28",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.3.4",
  "pi": {
    "extensions": [
      "./src/tau.ts",
      "./node_modules/cc-safety-net/dist/pi/index.js",
      "./node_modules/pi-web-access/dist/index.js"
    ],
    "skills": [
      "./src/skills"
    ]
  }
}
