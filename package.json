{
  "name": "tau",
  "version": "1.0.0",
  "private": true,
  "description": "Opinionated workflow governor for pi.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "vp config",
    "test": "vp test",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.66.1",
    "@mariozechner/pi-coding-agent": "^0.66.1",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.66.1"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pi": {
    "extensions": [
      "./src/extensions"
    ],
    "skills": [
      "./skills"
    ]
  }
}
