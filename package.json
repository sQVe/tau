{
  "name": "tau",
  "version": "1.0.0",
  "private": true,
  "description": "Opinionated workflow governor for pi.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main",
    "changeset:version": "changeset version",
    "check": "pnpm typecheck && pnpm style:check && pnpm format:check && pnpm test",
    "fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "style:check": "node scripts/runStyle.ts",
    "style:fix": "node scripts/runStyle.ts --fix",
    "prepare": "vp config",
    "test": "vp test",
    "test:changed": "vp test --changed",
    "test:unit": "vp test --exclude '**/*.integration.test.ts'",
    "typecheck": "pnpm exec tsc --noEmit",
    "release:github": "pnpm changeset tag"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.85.1",
    "@juicesharp/rpiv-ask-user-question": "2.9.0",
    "cc-safety-net": "2.4.1",
    "nanoid": "3.3.18",
    "pi-web-access": "0.28.0",
    "typebox": "1.3.28"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@oxlint/plugins": "1.79.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.13.3",
    "jiti": "2.7.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.3.4",
  "pi": {
    "extensions": [
      "./src/extensions",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/cc-safety-net/dist/pi/index.js",
      "./node_modules/pi-web-access/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
