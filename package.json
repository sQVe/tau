{
  "name": "tau",
  "version": "1.1.0",
  "private": true,
  "description": "Opinionated workflow governor for pi.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "build": "echo 'tau: no build step required yet'",
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main",
    "changeset:version": "changeset version",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:rules && pnpm format:check && pnpm test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:rules": "ast-grep scan",
    "prepare": "vp config",
    "test": "vp test",
    "typecheck": "pnpm exec tsc --noEmit",
    "release:github": "pnpm changeset tag"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "0.66.1",
    "@sinclair/typebox": "0.34.52",
    "proper-lockfile": "4.1.2",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "3.0.2",
    "@mariozechner/pi-ai": "^0.66.1",
    "@mariozechner/pi-coding-agent": "^0.66.1",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.66.1"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pi": {
    "extensions": [
      "./src/extensions"
    ],
    "skills": [
      "./skills"
    ]
  }
}
