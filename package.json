{
  "name": "tau",
  "version": "1.6.1",
  "private": true,
  "description": "Opinionated workflow governor for pi.",
  "keywords": [
    "pi-package"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "build:tau": "node scripts/buildTauExtension.ts",
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main",
    "changeset:version": "changeset version && vp fmt",
    "check": "pnpm pi-version:check && pnpm run \"/^check:static:/\" && pnpm build:tau && node scripts/runTestProjects.ts",
    "check:static:format": "pnpm format:check",
    "check:static:knip": "pnpm knip",
    "check:static:stomme": "mise exec -- stomme check",
    "check:static:style": "pnpm style:check",
    "check:static:typecheck": "pnpm typecheck",
    "fix": "vp lint --fix && vp fmt",
    "knip": "knip",
    "pi-version:check": "node scripts/checkPiVersion.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "style:check": "stomme-ts-style",
    "style:fix": "stomme-ts-style --fix",
    "postinstall": "node scripts/buildTauExtension.ts",
    "prepare": "node scripts/prepare.ts",
    "question-gate-score": "node scripts/questionGateScore.ts",
    "prose-report": "node scripts/proseReport.ts",
    "session-health": "node scripts/sessionHealth.ts",
    "test": "vp test",
    "test:changed": "vp test --changed",
    "test:coverage": "vp test --coverage",
    "test:unit": "vp test --project '!integration*'",
    "smoke:pi": "node scripts/piSmoke.ts",
    "pi-session": "node scripts/piSession.ts",
    "mutation": "mutation",
    "token-usage": "node scripts/tokenUsage.ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "release:github": "pnpm changeset git-tag"
  },
  "dependencies": {
    "@voidzero-dev/vite-plus-core": "0.3.3",
    "@xmldom/xmldom": "0.9.12",
    "cc-safety-net": "2.8.2",
    "entities": "9.0.0",
    "github-slugger": "2.0.0",
    "marked": "18.2.1",
    "minimatch": "11.0.9",
    "pi-web-access": "0.48.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@earendil-works/pi-ai": "1.7.0",
    "@earendil-works/pi-coding-agent": "1.7.0",
    "@earendil-works/pi-tui": "1.7.0",
    "@oxlint/plugins": "1.79.0",
    "@sqve/mutation": "0.2.0",
    "@sqve/stomme-ts-style": "0.4.0",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "@stryker-mutator/util": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.11.0",
    "jiti": "2.7.0",
    "knip": "6.48.0",
    "oxc-parser": "0.156.0",
    "oxlint": "1.79.0",
    "typebox": "1.3.28",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.23.0",
  "pi": {
    "extensions": [
      "./src/tau.ts",
      "./node_modules/cc-safety-net/dist/pi/index.js",
      "./node_modules/pi-web-access/dist/index.js"
    ],
    "skills": [
      "./src/skills"
    ]
  }
}
