{
  "tdd": {
    "productionGlobs": ["{src,scripts}/**/*.ts"]
  },
  "mutation": {
    "argv": ["pnpm", "exec", "mutation"]
  },
  "fullCheck": {
    "argv": ["pnpm", "check"]
  },
  "verification": {
    "targets": {
      "pi-session": {
        "launch": ["sh", "-c", "mkdir \"/tmp/tau-verification-$TAU_VERIFICATION_RUN\""],
        "doctor": [
          "sh",
          "-c",
          "test -d \"/tmp/tau-verification-$TAU_VERIFICATION_RUN\" && pi --version >/dev/null && pnpm pi-version:check"
        ],
        "stop": ["true"]
      }
    }
  }
}
