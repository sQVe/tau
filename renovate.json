{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>sQVe/stomme//renovate/stomme"
  ],
  "timezone": "Europe/Stockholm",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Group and automerge non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "GitHub Actions",
      "automerge": true
    },
    {
      "description": "Require dashboard approval for major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group and automerge non-major devDependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "devDependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Require dashboard approval for major devDependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require dashboard approval for major production updates",
      "matchDepTypes": ["dependencies", "peerDependencies"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "vite-plus bundles oxlint, @oxlint/plugins, and vitest, and @sqve/stomme-ts-style pins its vite-plus peer, so these move together only when approved on the dashboard. oxlint 1.92 and later need vite-plus 1.6 to load vite.config.ts.",
      "matchPackageNames": ["vite-plus", "oxlint", "@oxlint/plugins", "vitest", "@vitest/**"],
      "groupName": "Vite+ toolchain",
      "dependencyDashboardApproval": true
    },
    {
      "description": "oxlint 1.92 and later need vite-plus 1.6 to load vite.config.ts.",
      "matchPackageNames": ["oxlint", "@oxlint/plugins"],
      "allowedVersions": "<1.92.0"
    },
    {
      "description": "Pi 1.6.0 provides typebox 1.3 at runtime, so the development copy stays on 1.3 until Pi moves.",
      "matchPackageNames": ["typebox"],
      "allowedVersions": "<1.4.0"
    }
  ]
}
