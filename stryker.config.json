{
  "testRunner": "vitest",
  "vitest": {
    "configFile": "stryker.vitest.config.ts",
    "related": true
  },
  "coverageAnalysis": "perTest",
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts", "!src/**/fixtures/**", "!src/tau.ts"],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "checkers": [],
  "plugins": ["@stryker-mutator/vitest-runner"],
  "concurrency": "50%",
  "timeoutMS": 20000,
  "timeoutFactor": 4,
  "fileLogLevel": "off",
  "ignorePatterns": [".tau", "docs", "CHANGELOG.md"],
  "tempDirName": ".tau/stryker-tmp",
  "cleanTempDir": true,
  "dryRunTimeoutMinutes": 20,
  "incremental": true,
  "incrementalFile": ".tau/stryker-incremental.json"
}
